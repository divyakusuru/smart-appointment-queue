generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueuePriority {
  NORMAL
  PRIORITY
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  SKIPPED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  appointments    Appointment[]
  queues          Queue[]
  waitlistEntries Waitlist[]
  reservations    Reservation[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources       Resource[]
  services        Service[]
  businessHours   BusinessHour[]
  holidays        Holiday[]
  appointments    Appointment[]
  queues          Queue[]
  waitlistEntries Waitlist[]
  reservations    Reservation[]
}

model Service {
  id          Int      @id @default(autoincrement())
  branchId    Int
  name        String
  description String?
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  capacity    Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  waitlistEntries Waitlist[]
  reservations    Reservation[]
  serviceResources ServiceResource[]

  @@index([branchId, active])
}

model Resource {
  id        Int      @id @default(autoincrement())
  branchId  Int
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointmentResources AppointmentResource[]
  reservations         Reservation[]
  serviceResources     ServiceResource[]

  @@index([branchId, active])
}

model ServiceResource {
  id         Int @id @default(autoincrement())
  serviceId  Int
  resourceId Int

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceId])
  @@index([serviceId])
  @@index([resourceId])
}

model BusinessHour {
  id         Int     @id @default(autoincrement())
  branchId   Int
  dayOfWeek  Int
  openTime   String
  closeTime  String
  breakStart String?
  breakEnd   String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  branchId    Int
  date        DateTime @db.Date
  description String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
}

model Appointment {
  id                Int               @id @default(autoincrement())
  appointmentNumber String            @unique
  userId            Int
  branchId          Int
  serviceId         Int
  appointmentDate   DateTime          @db.Date
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(CONFIRMED)
  notes             String?
  queue             Queue?
  idempotencyKey    String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch    Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service   Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  resources AppointmentResource[]

  @@index([userId, appointmentDate])
  @@index([branchId, appointmentDate, status])
  @@index([serviceId, appointmentDate, startTime])
}

model AppointmentResource {
  id            Int @id @default(autoincrement())
  appointmentId Int
  resourceId    Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, resourceId])
  @@index([resourceId])
}

model Queue {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique
  userId        Int
  branchId      Int
  queueDate     DateTime      @db.Date
  position      Int
  priority      QueuePriority @default(NORMAL)
  status        QueueStatus   @default(WAITING)
  calledAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, queueDate, position])
  @@index([branchId, queueDate, status])
  @@index([userId, queueDate])
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED
  EXPIRED
}

model Waitlist {
  id            Int            @id @default(autoincrement())
  userId        Int
  branchId      Int
  serviceId     Int
  requestedDate DateTime       @db.Date
  requestedTime String?
  status        WaitlistStatus @default(WAITING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([branchId, serviceId, requestedDate, status])
  @@index([userId, status])
}

model Reservation {
  id           Int               @id @default(autoincrement())
  token        String            @unique
  userId       Int
  branchId     Int
  serviceId    Int
  reservedDate DateTime          @db.Date
  startTime    DateTime
  endTime      DateTime
  expiresAt    DateTime
  status       ReservationStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource? @relation(fields: [resourceId], references: [id])
  resourceId Int?

  @@index([branchId, serviceId, reservedDate, status])
  @@index([expiresAt, status])
  @@index([userId, status])
}
